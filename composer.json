{
	"name": "nextcloud/googletwowaysync",
	"description": "Syncs Google calendars, contacts, and tasks with Nextcloud in both directions using the Google Calendar API, People API, and Tasks API. Each task list gets its own calendar that holds only tasks, separate from event calendars. If the same item is changed on both sides, the later change is kept.",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "YouCha",
			"email": "chanha0406@gmail.com",
			"homepage": "https://github.com/chanha0406/google-twoway-sync"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\GoogleTwoWaySync\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"bamarni/composer-bin-plugin": "^1.8",
		"php": "^8.1"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable31",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	}
}
